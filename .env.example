# Copy this file to .env and change the values. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Default admin, created by: python manage.py create_default_admin
# CHANGE THESE BEFORE ANY DEPLOYMENT.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-Admin@123
ADMIN_EMAIL=admin@example.com

# Email: "file" writes emails to sent_emails/ (works offline). "smtp" uses the settings below.
EMAIL_MODE=file
DEFAULT_FROM_EMAIL=orders@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Password given to the 4 demo customers created by seed_demo (demo data only).
DEMO_CUSTOMER_PASSWORD=change-me-Demo@123
